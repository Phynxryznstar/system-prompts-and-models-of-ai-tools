# Copy this file to .env in this same directory (deployment/.env) and
# fill in real values before running `docker-compose up --build`.
# See README_DEPLOYMENT.md for the full walkthrough.

# --- Neo4j ---
# Inside the docker-compose network, the backend reaches Neo4j at
# bolt://neo4j:7687 (the service name). If you point this at Neo4j Aura
# or another external instance instead, use its neo4j+s://... URI.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# --- URLs ---
# API_URL is the address the *browser* uses to reach the backend — it's
# baked into the frontend's build (Vite inlines it at build time), so it
# must be a host-reachable URL, not the internal `backend` service name.
API_URL=http://localhost:8000
# FRONTEND_URL is where the frontend is served from. The backend doesn't
# read it today (CORS is wide open for now — see api/server.py), but it's
# here for reference and for tightening CORS to a specific origin later.
FRONTEND_URL=http://localhost:5173
